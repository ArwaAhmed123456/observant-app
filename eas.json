{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://observant-api-zl49.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://observant-api-zl49.onrender.com"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview-device": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://observant-api-zl49.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://observant-api-zl49.onrender.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6819709526",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyIssuerId": "$EXPO_ASC_ISSUER_ID",
        "ascApiKeyId": "$EXPO_ASC_KEY_ID"
      }
    }
  }
}
