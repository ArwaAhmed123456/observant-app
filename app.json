{
  "expo": {
    "name": "Observant Guard & Patrol",
    "slug": "observant-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "observant",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.observant.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F4F6FA"
      },
      "navigationBar": {
        "backgroundColor": "#0B192C",
        "barStyle": "light-content"
      },
      "permissions": [
        "CAMERA",
        "NFC",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.observant.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Observant requires camera access to scan security checkpoint QR codes and attach photos to incident reports.",
        "NSLocationWhenInUseUsageDescription": "Observant uses your location to verify security guard checkpoint patrols.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Observant uses location tracking during active security patrol tours."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B192C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Observant to access your camera to scan QR codes and capture incident photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Observant to use your location for security patrol verification."
        }
      ],
      [
        "react-native-nfc-manager",
        { "nfcPermission": "Allow Observant to verify assigned patrol checkpoint cards." }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "39c51413-0f88-44ea-9c4d-21ce3430dd45"
      }
    },
    "owner": "hayat123a"
  }
}
